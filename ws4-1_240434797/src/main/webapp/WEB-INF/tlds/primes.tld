<?xml version="1.0" encoding="UTF-8" ?>
<taglib xmlns="http://java.sun.com/xml/ns/javaee"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-jsptaglibrary_2_1.xsd"
        version="2.1">

    <tlib-version>1.0</tlib-version>
    <short-name>primes</short-name>
    <uri>/WEB-INF/tlds/primes.tld</uri>

    <tag>
        <name>prime</name>
        <tag-class>ict.tags.PrimeTag</tag-class>
        <body-content>empty</body-content>
        <attribute><name>min</name><required>true</required><rtexprvalue>true</rtexprvalue></attribute>
        <attribute><name>max</name><required>true</required><rtexprvalue>true</rtexprvalue></attribute>
        <attribute><name>tagType</name><required>true</required><rtexprvalue>true</rtexprvalue></attribute>
    </tag>
</taglib>
