<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         version="3.1">

  <!-- Database connection parameters -->
  <context-param>
    <param-name>dbUrl</param-name>
    <param-value>jdbc:mysql://localhost:3306/ITP4511_DB</param-value>
  </context-param>

  <context-param>
    <param-name>dbUser</param-name>
    <param-value>root</param-value>
  </context-param>

  <context-param>
    <param-name>dbPassword</param-name>
    <param-value></param-value> <!-- leave blank or set your password -->
  </context-param>

  <!-- Servlet mapping -->
  <servlet>
    <servlet-name>LoginController</servlet-name>
    <servlet-class>ict.servlet.LoginController</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>LoginController</servlet-name>
    <url-pattern>/main</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>BrandController</servlet-name>
    <servlet-class>ict.servlet.BrandController</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>BrandController</servlet-name>
    <url-pattern>/brandController</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>PhoneController</servlet-name>
    <servlet-class>ict.servlet.PhoneController</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>PhoneController</servlet-name>
    <url-pattern>/getPhones</url-pattern>
  </servlet-mapping>

</web-app>
